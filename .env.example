# =============================================================================
# GymMap — environment template
#
# Copy to .env.local and fill in. .env.local is git-ignored and Gitleaks-scanned
# (ENGINEERING_PLAN.md §C7 "Local" row).
#
# Naming: SCREAMING_SNAKE_CASE, prefixed by domain (Deployment.md CF-1).
# Every variable here is validated at boot by a Zod schema (A-02); an unset or
# malformed value fails startup rather than surfacing as a null at runtime.
#
# NEVER put a real credential in this file. It is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
APP_REGION=ap-south-1               # India. Mandatory under RBI payment-data
                                    # localisation (OQ-16) — not configurable.
LOG_LEVEL=debug                     # trace | debug | info | warn | error
PORT=3000

# -----------------------------------------------------------------------------
# Database — Postgres 16 + PostGIS (infra/compose)
#
# The application role must NOT have BYPASSRLS (Schema.md). Local development
# uses the superuser for migrations only; at Phase 8 a separate, RLS-bound
# application role is created and used by the runtime.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymmap?schema=public
PLATFORM_DATABASE_URL=               # M-014. Unset locally; Terraform sets the gymmap_platform credential
AUDIT_DATABASE_URL=                  # M-013. Unset locally; Terraform sets the gymmap_audit credential
DATABASE_REPLICA_URL=               # empty locally; a read replica exists from staging up

# -----------------------------------------------------------------------------
# Redis 7 — cache, rate-limiter buckets (A-13), BullMQ queues
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# M-005 AC-2 - three logical databases, matching infra/terraform/modules/redis.
# Kept separate so a FLUSHDB on the cache cannot delete accepted BullMQ jobs.
# Redis is capped at exactly 3 databases in compose, so 0-2 only.
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1
REDIS_DB_RATELIMIT=2

# -----------------------------------------------------------------------------
# Object storage — MinIO locally, any S3-compatible provider elsewhere (A-18)
#
# Two buckets with different lifecycles: media is public-read behind a CDN,
# KYC is private and access-logged.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true            # MinIO needs path-style; real S3 does not
S3_MEDIA_BUCKET=gymmap-media
S3_KYC_BUCKET=gymmap-kyc
CDN_BASE_URL=http://localhost:9000/gymmap-media

# -----------------------------------------------------------------------------
# Authentication — JWT access + rotating refresh tokens, httpOnly (§C1.1)
#
# Generate real values, do not reuse these:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGEME_generate_a_48_byte_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=CHANGEME_generate_a_different_48_byte_random_value
JWT_REFRESH_TTL=30d

# QR check-in token signing — Ed25519, 60 s TTL, rotating key with kid (A-11).
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString().replace(/\n/g,'\\n'))"
QR_SIGNING_PRIVATE_KEY=CHANGEME_ed25519_pkcs8_pem
QR_SIGNING_KEY_ID=local-dev-1
QR_TOKEN_TTL_SECONDS=60

# Argon2id parameters (A-12, FR-AUTH-04). Tuned values must be recorded in
# DECISION_LOG.md. These are deliberately weak so local tests stay fast.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# Payments — PaymentProvider port (§C1.1). India adapter is Razorpay Route
# (EP-08); Stripe Connect remains the port's contract-test reference only.
# -----------------------------------------------------------------------------
# LOCAL DEFAULT IS 'stub', not 'razorpay'.
#
# .env.example must be copyable verbatim into a working server. With 'razorpay' and the
# empty keys below, the cross-field rule in app-config.schema.ts correctly refuses to boot,
# so a fresh clone failed on the very first run. Razorpay also has no local sandbox that
# works without an account, and the account needs KYC that has not been done yet.
#
# Set this to 'razorpay' in .env.local once the three values below are real. Production
# refuses 'stub' outright - the stub approves every payment.
PAYMENT_PROVIDER=stub                # stub | razorpay | stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=             # membership activation is webhook-driven (BR-PAY-02)

# -----------------------------------------------------------------------------
# Notifications — vendors deferred pending A-19. Mailpit is the local sink.
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GymMap <no-reply@gymmap.local>"
SMS_PROVIDER=console                 # console sink until A-19 resolves. Never a
                                     # real handset outside production (DLT).

# -----------------------------------------------------------------------------
# Observability — OpenTelemetry + Sentry (A-15, §C1.1)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=         # empty locally = traces disabled
OTEL_SERVICE_NAME=gymmap-server
SENTRY_DSN=                          # empty locally = error tracking disabled
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Localisation — India (LAUNCH_MARKET_INDIA.md)
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=INR                 # stored as integer paise (BR-PAY-01)
DEFAULT_TIMEZONE=Asia/Kolkata        # UTC+05:30, no DST
DEFAULT_LOCALE=en-IN                 # lakh-crore digit grouping
GST_RATE_BPS=1800                    # 18%, split CGST+SGST on intra-state supply
FINANCIAL_YEAR_START_MONTH=4         # April-March

# -----------------------------------------------------------------------------
# Commission — OQ-02: 10% standard / 5% renewal, in basis points
# -----------------------------------------------------------------------------
COMMISSION_STANDARD_BPS=1000
COMMISSION_RENEWAL_BPS=500
