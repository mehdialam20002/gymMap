#!/usr/bin/env sh
# A-24 · pre-commit — format staged files, then scan them for secrets.

pnpm exec lint-staged || exit 1

# A-25 · Gitleaks. Optional locally, mandatory in CI (.github/workflows/security.yml).
# If the binary is absent we say so once rather than failing the commit, because a
# missing local tool is not a security finding — CI still gates the merge.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml || {
    echo ""
    echo "  A secret was detected in the staged changes."
    echo "  Do not allowlist it. Rotate the credential, remove it from the diff, and re-stage."
    exit 1
  }
else
  echo "  note: gitleaks not installed locally — secret scan deferred to CI."
  echo "        install: winget install gitleaks"
fi
