# EditorConfig — https://editorconfig.org
# Mirrors packages/config/prettier. Where the two could disagree, Prettier wins
# at commit time via lint-staged (A-24); this file only shapes live typing.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown; stripping them
# silently reflows ~90,000 lines of specification.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.prisma]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
