# Supply-chain and resolution posture — NFR-SEC-08
#
# Scoped @gymmap/* names mean a typo resolves to nothing rather than to a
# public package (FolderStructure.md §3.2).

# Refuse to install under an engine other than the one pinned in package.json.
engine-strict=true

# Nothing is hoisted to the root node_modules, so a package that is not a
# declared dependency does not resolve. Phantom dependencies are how an
# unapproved library (STACK_ADDITIONS.md standing rule) enters the build
# unnoticed. pnpm's internal virtual-store hoisting is left at its default,
# because disabling it outright (hoist=false) breaks packages that rely on
# implicit resolution.
public-hoist-pattern=

# The lockfile is authoritative in CI.
prefer-frozen-lockfile=true

# Peer handling: install them, but do not fail the build on a mismatch that
# the resolution graph can satisfy.
auto-install-peers=true
strict-peer-dependencies=false

# A published version must be at least 24 h old before it is installable.
# Blunts the window in which a compromised release is pulled on publish day.
# Units are minutes. Raise to 10080 (7 days) if a supply-chain incident occurs.
minimum-release-age=1440
