{
  "name": "gymmap",
  "version": "0.0.0",
  "private": true,
  "description": "Gym Marketplace & Multi-Tenant Gym Management SaaS — monorepo root",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "//": "R1a — the root has NO `dependencies` block, not an empty one. devDependencies are limited to turbo, prettier, husky, lint-staged, @commitlint/*, dependency-cruiser and typescript. An accidental root dependency is invisible to size-limit (A-29) and to per-app Dockerfile pruning.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "architecture": "turbo run architecture",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:contract": "turbo run test:contract",
    "test:isolation": "turbo run test:isolation",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "turbo run test:a11y",
    "size": "turbo run size",
    "openapi:check": "turbo run openapi:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/compose/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose/compose.yaml down",
    "infra:reset": "docker compose -f infra/compose/compose.yaml down -v && docker compose -f infra/compose/compose.yaml up -d",
    "infra:logs": "docker compose -f infra/compose/compose.yaml logs -f",
    "infra:ps": "docker compose -f infra/compose/compose.yaml ps",
    "prepare": "husky",
    "dev:up": "pnpm infra:up",
    "dev:down": "pnpm infra:down",
    "dev:reset": "pnpm infra:reset",
    "infra:verify": "node infra/compose/verify.mjs",
    "ci:module-structure": "node packages/config/scripts/module-structure.mjs",
    "ci:actions-pinned": "node packages/config/scripts/actions-pinned.mjs",
    "ci:deps-approved": "node packages/config/scripts/dependency-approval.mjs",
    "ci:violations": "for f in .github/deliberate-violations/*.spec.sh; do bash \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "dependency-cruiser": "^18.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  }
}
