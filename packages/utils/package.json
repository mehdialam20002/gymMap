{
  "name": "@gymmap/utils",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "//": "M-001 · §3.6 script contract. A no-op is the literal string, never a missing script.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "architecture": "echo \"no-op\"",
    "test:unit": "node --test test/*.spec.ts",
    "test:int": "echo \"no-op\"",
    "test:contract": "echo \"no-op\"",
    "test:isolation": "echo \"no-op\"",
    "test:e2e": "echo \"no-op\"",
    "test:a11y": "echo \"no-op\"",
    "size": "echo \"no-op\"",
    "openapi:check": "echo \"no-op\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gymmap/config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "//lint": "R1a keeps the ROOT devDependencies to seven packages, and eslint is not one of them — so each workspace that lints declares its own. The shared rule set still lives in one place (@gymmap/config/eslint); only the runner is per-package."
}
