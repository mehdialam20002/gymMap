{
  "name": "@gymmap/config",
  "version": "0.0.0",
  "private": true,
  "description": "One configuration source for every workspace — tsconfig presets, and from M-002 the ESLint, Prettier, Jest, dependency-cruiser, commitlint, Playwright and size-limit configs.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/node": "./tsconfig/node.json",
    "./tsconfig/react": "./tsconfig/react.json",
    "./tsconfig/nest": "./tsconfig/nest.json"
  },
  "//": "M-001 · §3.6 script contract. A no-op is the literal string, never a missing script — a missing script makes `turbo run` succeed by omission, which is indistinguishable from passing.",
  "scripts": {
    "build": "echo \"no-op\"",
    "typecheck": "echo \"no-op\"",
    "lint": "eslint .",
    "architecture": "depcruise --config ../../.dependency-cruiser.cjs ../../apps ../../packages --output-type err",
    "test:unit": "node --test test/*.spec.mjs eslint/rules/*.spec.cjs dependency-cruiser/*.spec.cjs",
    "test:int": "echo \"no-op\"",
    "test:contract": "echo \"no-op\"",
    "test:isolation": "echo \"no-op\"",
    "test:e2e": "echo \"no-op\"",
    "test:a11y": "echo \"no-op\"",
    "size": "echo \"no-op\"",
    "openapi:check": "echo \"no-op\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.66.0"
  }
}
