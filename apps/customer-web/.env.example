# =============================================================================
# GymMap customer website - environment template
#
# Copy to `apps/customer-web/.env.local`, which is git-ignored and Gitleaks-scanned.
#
# THIS FILE AND NOT THE ROOT ONE. Next loads `.env.local` from the app directory, so a
# variable set in the repository root reaches this app not at all. It was in the root
# template first and the server's `.env.example` parity spec caught it: the root file is
# checked against the NestJS config schema, which has never read a CSP host.
#
# NEVER put a real credential in this file. It is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# CSP host allowlist — NFR-SEC-12. Read by `buildContentSecurityPolicy`.
#
# Each lands in exactly one directive and nowhere else, and the suite asserts that. Empty means
# `'self'` only, which is the correct default: an unset variable must never widen the policy.
# -----------------------------------------------------------------------------
CSP_API_HOST=
# img-src AND media-src. `images.pexels.com` locally, because the fixture catalogue's photography
# comes from there until real gym media exists (FR-GYM-02). Replace with the CDN, do not append.
CSP_MEDIA_HOST=https://images.pexels.com
CSP_TILE_HOST=
CSP_INGEST_HOST=
CSP_PAYMENT_HOST=

# -----------------------------------------------------------------------------
# The public origin, for structured data — FR-SRCH-13.
#
# The `ItemList` on a city or activity landing publishes absolute URLs, and they have to be the
# canonical ones. Built from a request's `Host` header they would be URLs an attacker can set,
# and those URLs end up in a search index — so this is configured and never inferred.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3001
