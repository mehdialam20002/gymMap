{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@gymmap/config/tsconfig/react",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "incremental": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "middleware.ts",
    "test/**/*.ts",
    "*.ts",
    "*.mjs",
    ".next/types/**/*.ts",
    "src/**/*.d.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
