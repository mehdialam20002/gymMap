  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite --port 3003",
    "preview": "vite preview --port 3003",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "architecture": "echo \"no-op\"",
    "test:unit": "node --test test/*.spec.ts",
    "test:int": "echo \"no-op\"",
    "test:contract": "echo \"no-op\"",
    "test:isolation": "echo \"no-op\"",
    "test:e2e": "echo \"no-op\"",
    "test:a11y": "echo \"no-op\"",
    "size": "echo \"no-op\"",
    "openapi:check": "echo \"no-op\""
  },
  "dependencies": {
    "@gymmap/types": "workspace:*",
    "@gymmap/ui": "workspace:*",
    "@gymmap/utils": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.62.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gymmap/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.7"
  },
  "//lint": "Was echo no-op until the redesign, which meant the app with the most TSX in the repository was the one nothing checked. ESLint is A-21 and the runner is per-workspace by R1a; the rule set still comes from the root eslint.config.mjs, which re-exports packages/config/eslint. Both sibling SPAs were turned on in the same change, so `turbo run lint` now covers all eight workspaces rather than five."
}
