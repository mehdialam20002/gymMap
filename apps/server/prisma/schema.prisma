// M-006 · The Prisma schema. ZERO MODELS, deliberately.
//
// ┌─ READ THIS BEFORE RUNNING `prisma migrate dev` ────────────────────────────────────────┐
// │ Prisma's diff engine knows nothing about roles, domains, policies or grants. It sees   │
// │ only models. `0_init` creates 81 enum types, 12 domains, 4 roles and a blanket revoke, │
// │ and NONE of that appears below — so the diff engine reads all of it as drift and will  │
// │ cheerfully generate a migration that DROPS it.                                          │
// │                                                                                         │
// │ Dropping the four roles is dropping the enforcement of BR-TEN-01.                       │
// │                                                                                         │
// │ Therefore: migrations in this project are HAND-WRITTEN and validated by                 │
// │ packages/config/scripts/migration-lint.mjs. Use `prisma migrate diff` to INSPECT, and   │
// │ `prisma migrate deploy` to APPLY. Never `prisma migrate dev` against a real database.   │
// └─────────────────────────────────────────────────────────────────────────────────────────┘
//
// Tables arrive one migration at a time from M-009 onward, each carrying its RLS policy and
// grants in the same file (MG10, P9, R-6). Models are added here to match, never ahead.

generator client {
  provider = "prisma-client-js"
  // No custom output. pnpm puts @prisma/client in a content-addressed store directory, and
  // the runtime resolves the generated client RELATIVE TO ITSELF — so an output path that
  // looks right (apps/server/node_modules/.prisma/client) leaves the package unable to find
  // what was just generated, and every import fails with "did not initialize yet".
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// §8.6 — models are PascalCase and map to snake_case tables via @@map. The database is the
// contract with SQL, psql and every report; the model name is a TypeScript convenience.

/// M-009 · The gym business — Schema.md §4.1.
///
/// Tenancy class RLS, policy class **P-SELF**: this table has no `tenant_id` column because
/// its own primary key IS the tenant id. Adding one would be a second copy of the same fact,
/// and the two could disagree.
///
/// Prisma cannot express RLS, so nothing below hints that reading this model is scoped. It is
/// scoped by the policy in the migration and by the tenant-context extension (M-010), and a
/// repository that reaches the raw client bypasses both — which is why
/// `no-raw-prisma-outside-tenancy` is a build-failing dependency-cruiser rule and not advice.
model Tenant {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  legalName          String  @map("legal_name")
  tradingName        String? @map("trading_name")
  entityType         EntityTypeEnum @map("entity_type")
  registrationNumber String? @map("registration_number")
  countryCode        String  @default("IN") @map("country_code") @db.Char(2)
  currency           String  @default("INR") @db.Char(3)
  /// AUTHORITATIVE for all validity computation (TM3, ADR-0025).
  timezone           String  @default("Asia/Kolkata")
  status             TenantStatusEnum @default(DRAFT)

  subscriptionTierId       String?  @map("subscription_tier_id") @db.Uuid
  subscriptionStatus       SubscriptionStatusEnum @default(TRIAL) @map("subscription_status")
  subscriptionPastDueSince DateTime? @map("subscription_past_due_since") @db.Timestamptz(6)

  /// Basis points, never a decimal fraction (§10.4, R3). NULL resolves from tier then platform.
  commissionRateBps        Int? @map("commission_rate_bps")
  renewalCommissionRateBps Int? @map("renewal_commission_rate_bps")
  settlementCycleDays      Int  @default(7) @map("settlement_cycle_days")
  reserveBps               Int  @default(500) @map("reserve_bps")
  reserveReleaseDays       Int  @default(30) @map("reserve_release_days")
  payoutHoldUntil          DateTime? @map("payout_hold_until") @db.Date
  /// BigInt, never Float. Integer minor units (BR-PAY-01, NFR-DQ-02).
  minimumPayoutMinor       BigInt @default(0) @map("minimum_payout_minor")

  taxProfileId          String? @map("tax_profile_id") @db.Uuid
  /// PERSONAL/FINANCIAL IDENTIFIER. Redacted from logs (BR-DAT-06).
  pan                   String? @db.Text
  gstin                 String? @db.Text
  /// Decides CGST+SGST versus IGST.
  stateCode             String? @map("state_code") @db.Char(2)
  taxRegistrationStatus TaxRegistrationStatusEnum @default(NOT_REGISTERED) @map("tax_registration_status")

  registeredAddressLine1 String? @map("registered_address_line1")
  registeredAddressLine2 String? @map("registered_address_line2")
  registeredCity         String? @map("registered_city")
  registeredState        String? @map("registered_state")
  registeredPostalCode   String? @map("registered_postal_code")

  /// Snapshotted onto every order at sale time (BR-REF-01).
  refundPolicy Json @default("{\"schema_version\":1}") @map("refund_policy")

  /// Soft delete (ADR-0024). Financial and audit records are retained regardless (BR-TEN-04).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// M-019. The back-relation for `user_roles.tenant_id`. Present so the FK is visible in the
  /// datamodel; `user_roles` itself is IDENTITY-class and carries no RLS policy.
  userRoles UserRole[]

  @@index([status, createdAt(sort: Desc)], map: "idx_tenants__status_created_at")
  @@map("tenants")

  applications Application[]
  kycDocuments KycDocument[]
}

// The enums below are a SUBSET of the 81 created by 0_init — only those `tenants` references.
// Prisma requires a declaration for each enum it maps; the migration remains the source of
// truth, and `prisma migrate diff` is the check that the two have not drifted.

enum EntityTypeEnum {
  SOLE_PROPRIETOR
  PARTNERSHIP
  COMPANY
  OTHER

  @@map("entity_type_enum")
}

enum TenantStatusEnum {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  CLOSED

  @@map("tenant_status_enum")
}

enum SubscriptionStatusEnum {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED

  @@map("subscription_status_enum")
}

enum TaxRegistrationStatusEnum {
  NOT_REGISTERED
  REGISTERED
  COMPOSITION
  PENDING

  @@map("tax_registration_status_enum")
}

/// M-017 · One row per client-supplied `Idempotency-Key` — BR-PAY-03, §14.2.1.
///
/// `@@unique([key])` and NOT `@@unique([tenantId, key])`. SC-R06 normally requires every unique
/// index to lead with `tenant_id`; this is one of the five closed exceptions (Schema.md §2.9),
/// because the constraint IS the concurrency control: two simultaneous requests with the same
/// key must COLLIDE, and that collision — raised as SQLSTATE 23505 on a single INSERT — is what
/// makes "exactly one executes" true without a lock, a queue or a distributed mutex.
///
/// Isolation is unaffected. The row carries `tenantId` and the P-STD policy governs every READ,
/// so tenant B cannot replay tenant A's stored response. The unique index constrains INSERTS and
/// the policy constrains READS; they are different mechanisms and only one is about isolation.
model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid

  key      String @unique(map: "uq_idempotency_keys__key")
  tenantId String @map("tenant_id") @db.Uuid
  endpoint String

  /// SHA-256 of method, path, tenant and the canonicalised body. Excludes volatile headers, so
  /// the same logical retry from a different client build is still a retry.
  requestHash String @map("request_hash") @db.Char(64)

  /// NULL means IN FLIGHT — the state a concurrent second request waits on. The row is inserted
  /// BEFORE the work for exactly this reason.
  responseStatus Int?  @map("response_status") @db.SmallInt
  responseBody   Json? @map("response_body")

  /// The ORIGINAL request's correlation id, replayed with the stored response so a support
  /// agent tracing a retry lands on the request that actually did the work.
  correlationId String @map("correlation_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// Configuration, not a constant — TR-36 requires it to be at least the payment provider's
  /// retry window, and both numbers are recorded in DECISION_LOG.md.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "ix_idempotency_keys__expires_at")
  @@index([tenantId, key], map: "ix_idempotency_keys__tenant_key")
  @@map("idempotency_keys")
}

/// M-018 · The transactional outbox — Schema.md §13.1, ADR-0017, §C1.5.
///
/// Written in the SAME transaction as the state change it describes. That is the whole point:
/// "save then publish" loses the event if the process dies between them, and "publish then save"
/// acts downstream on a state that never committed. One transaction makes both impossible.
///
/// `aggregateType` is String and not an enum — BLK-07. Schema.md §2.5 cites a list of 26
/// aggregate roots at ERD.md §6, which contains no such list, and deriving it yields 36
/// candidates. MG9 makes an enum value permanent, so guessing is worse than deferring.
model OutboxEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  aggregateType String @map("aggregate_type")
  /// NO relation, deliberately: the outbox is purged 30 days after publish while aggregates live
  /// for years, so the FK direction is wrong and the lifetimes do not nest.
  aggregateId   String @map("aggregate_id") @db.Uuid

  eventType String @map("event_type")
  payload   Json

  status   OutboxStatusEnum @default(PENDING)
  attempts Int              @default(0)

  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  correlationId String @map("correlation_id") @db.Uuid

  @@index([availableAt, id], map: "idx_outbox__pending")
  @@index([aggregateType, aggregateId, id], map: "idx_outbox__aggregate")
  @@map("outbox")
}

enum OutboxStatusEnum {
  PENDING
  PUBLISHED
  FAILED
  DEAD

  @@map("outbox_status_enum")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// M-019 · Identity and RBAC — Schema.md §4.6, §4.7, MASTER_PRD.md §B3.1.
//
// NONE of these five models is backed by a table with RLS. `users` and `userRoles` are the
// IDENTITY class — scoped by `user_id`, protected by authorisation — and the other three are
// platform-global reference data. Reaching them therefore does NOT require a tenant context,
// which is why `iam/` may hold the raw client where a tenant-scoped repository may not.
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// Schema.md §4.6. A platform identity — a person with credentials, contact points and
/// verification state.
///
/// IDENTITY class: no `tenantId`, no RLS. Classing this RLS is the `/me/memberships` bug of
/// §1.3 — a member holding memberships at three gyms would see an empty list, and it would
/// look like data loss rather than like a policy.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  /// Nullable, and at least one of email/phone is required by `ck_users__has_contact`. An
  /// India walk-in member may have only a phone (FR-CRM-04).
  ///
  /// NO `@unique` on either contact point, deliberately. The real indexes are PARTIAL on
  /// `deleted_at IS NULL` (SD7) so a soft-deleted account frees its address; `@unique` would
  /// generate a TOTAL unique index, and a person who deleted their account could never
  /// register again with the same email. Uniqueness is asserted in `users-constraints`.
  email           String?   @db.Text
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phone           String?   @db.Text
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)

  /// Argon2id. NULL for OTP-only accounts, which in India is the common case. NEVER logged,
  /// never exported (NFR-SEC-01, BR-DAT-06).
  passwordHash String? @map("password_hash")

  fullName      String? @map("full_name")
  displayLocale String  @default("en-IN") @map("display_locale")

  /// TM6, TM11 — presentation and quiet hours ONLY. A validity window uses the GYM's zone.
  presentationTimezone String? @map("presentation_timezone")

  status      UserStatusEnum @default(PENDING_VERIFICATION)
  mfaEnabled  Boolean        @default(false) @map("mfa_enabled")

  /// M-024 · `FR-AUTH-07`, `Security.md` §2.8. `mfaEnabled` is the flag; these carry the rest.
  ///
  /// `ck_users__mfa_enabled_has_timestamp` binds `mfaEnabled` to `mfaEnrolledAt` in the database,
  /// because two columns describing one fact diverge the moment a code path writes one of them.
  /// Prisma cannot express a cross-column CHECK, so the constraint lives in the migration and this
  /// comment is the only warning a reader gets here.
  ///
  /// The secret and the codes are C5: never logged, never returned after enrolment. `mfaSecret`
  /// holds an encryption ENVELOPE, never the raw 160 bits.
  mfaEnrolledAt        DateTime? @map("mfa_enrolled_at") @db.Timestamptz(6)
  mfaSecretEncrypted   String?   @map("mfa_secret_encrypted")
  mfaRecoveryCodesHashed String[] @map("mfa_recovery_codes_hashed")
  /// The highest accepted TOTP step. Refusing anything at or below it is what stops replay.
  mfaLastStep          BigInt?   @map("mfa_last_step")

  lastLoginAt DateTime?      @map("last_login_at") @db.Timestamptz(6)

  /// BR-DAT-04. The durable reference a financial record keeps after the identity is gone.
  pseudonymToken String?   @unique @map("pseudonym_token")
  erasedAt       DateTime? @map("erased_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles    UserRole[]
  sessions AuthSession[]

  @@index([status, createdAt(sort: Desc)], map: "ix_users__status_created_at")
  @@map("users")
}

/// Schema.md §4.7. One role granted to one user, optionally scoped to one tenant.
///
/// THE ONE TABLE IN THIS SCHEMA WITH A `tenant_id` AND NO RLS POLICY, by reviewed exception —
/// see `test/isolation/rls-coverage.sql`. A policy would evaluate `NULL = <uuid>` for every
/// platform-role row and make super-admins invisible to themselves.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  /// ERD.md §3.1 — NULLABLE IS THE DISCRIMINATOR. NULL is a platform role; a value is a
  /// tenant role. Never fill it with a sentinel.
  tenantId String? @map("tenant_id") @db.Uuid

  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// AC-STAF-01.4 — revocation is a timestamp, never a delete, so attribution survives.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The unique index is `UNIQUE NULLS NOT DISTINCT`, which Prisma cannot express. It lives in
  /// the migration and is asserted by `identity-tenancy-class.int-spec.ts`; declaring a plain
  /// `@@unique` here would generate a WEAKER constraint on any future `prisma db push`.
  @@index([userId, tenantId], map: "ix_user_roles__user_active")
  @@map("user_roles")
}

/// MASTER_PRD.md §B3.1. Exactly twelve. GLOBAL, G-REF.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  key PlatformRoleEnum @unique

  /// §B3.1 — evaluation is (role, scope, resource, action), NEVER role alone.
  scope       String
  description String

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// FR-RBAC-01. One atomic capability an endpoint declares. GLOBAL, G-REF.
model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  /// `<module>.<resource>.<action>` — the shape api-gates PG-3 enforces on every route.
  key         String @unique
  resource    String
  action      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

/// §B3.2. The composition of the matrix. GLOBAL, G-REF.
model RolePermission {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId], map: "uq_role_permissions__role_permission")
  @@index([permissionId], map: "ix_role_permissions__permission_id")
  @@map("role_permissions")
}

/// FR-AUTH, BR-DAT-04. `ERASED` is the terminal pseudonymised state.
enum UserStatusEnum {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ERASED

  @@map("user_status_enum")
}

/// §B3.1, verbatim. Twelve values; a thirteenth requires a PRD amendment.
enum PlatformRoleEnum {
  VISITOR
  USER
  MEMBER
  GYM_OWNER
  GYM_MANAGER
  RECEPTIONIST
  TRAINER
  SUPER_ADMIN
  VERIFICATION_OFFICER
  SUPPORT_AGENT
  FINANCE
  MODERATOR

  @@map("platform_role_enum")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// M-020 · Sessions and refresh tokens — Schema.md §4.8, ADR-0011, ADR-0035.
//
// Moved here from M-022 by ADR-0035: M-020's AC-4 requires a password reset to revoke every
// session (FR-AUTH-10, rank 2), and the milestone that creates the table is a rank-4 plan with
// a cycle in it. M-020 takes only the tables; JWT issue and rotation remain M-022's.
//
// Both are IDENTITY class — no tenantId, no RLS. A session belongs to a USER, and a user
// belongs to no single tenant.
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// Schema.md §4.8. One authenticated device session, listable and revocable by its owner.
model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// ADR-0011. The token family root — reuse detection revokes the family, not one token.
  familyId String @unique @map("family_id") @db.Uuid

  /// Shown on the FR-AUTH-09 sessions screen. `ip` is `inet` in SQL; Prisma has no inet type,
  /// so it is read as a string. Never widen the column to text — a text column sorts
  /// "10.0.0.2" before "9.0.0.1" and every range query becomes wrong.
  deviceLabel String? @map("device_label")
  userAgent   String? @map("user_agent")
  ip          String? @db.Inet

  status AuthSessionStatusEnum @default(ACTIVE)

  /// Absolute, not sliding. A session that refreshes forever is a session that never ends.
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(6)

  /// FR-AUTH-10. Revocation is a status and a timestamp — there is no DELETE grant, so
  /// "when was this member logged out, and why" survives an account-takeover investigation.
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")

  user   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokens RefreshToken[]

  @@index([userId], map: "idx_auth_sessions__user_active")
  @@index([userId, createdAt(sort: Desc)], map: "idx_auth_sessions__user_created")
  @@map("auth_sessions")
}

/// Schema.md §4.8, ERD.md §16.1 deviation D-04. Append-only with ONE completion transition.
///
/// Grant class G-COMPLETE: SELECT, INSERT, and UPDATE on (used_at, superseded_by_id) ONLY.
/// The column scope is the control — rotation must leave a chain, and a rewritten `generation`
/// or `tokenHash` would make reuse detection stop detecting while still appearing to work.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessionId String @map("session_id") @db.Uuid

  /// NFR-SEC-07. SHA-256 of the token. THE TOKEN ITSELF IS NEVER STORED — a database read must
  /// not be a session takeover. `char(64)` plus a lowercase-hex CHECK in SQL.
  tokenHash String @unique @map("token_hash") @db.Char(64)

  /// Monotonic within the family. Unique per session, which is what makes "a second use of a
  /// spent generation" a detectable event rather than an ambiguous one.
  generation Int

  supersededById String? @map("superseded_by_id") @db.Uuid

  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)

  session      AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  supersededBy RefreshToken?  @relation("RotationChain", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes   RefreshToken[] @relation("RotationChain")

  @@unique([sessionId, generation], map: "uq_refresh_tokens__session_generation")
  @@index([sessionId, generation(sort: Desc)], map: "idx_refresh_tokens__session")
  @@index([expiresAt], map: "idx_refresh_tokens__expires_at")
  @@map("refresh_tokens")
}

/// FR-AUTH-10. `EXPIRED` is reached by the TTL sweep, `REVOKED` by an explicit act.
enum AuthSessionStatusEnum {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("auth_session_status_enum")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// M-026 · the verification dossier — `Schema.md` §4.2, §4.3
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// One submitted dossier per (tenant, version). TENANT-OWNED: RLS enabled and forced, so the
/// Prisma tenant extension scopes every read and write and no repository filters by hand.
model Application {
  /// `dbgenerated`, not `@default(uuid())`. The migration gives the column a real DEFAULT so raw
  /// SQL (the seed, an int-spec) need not supply one — and a client-side default here would report
  /// as drift forever while both were right.
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid

  /// `BR-GYM-05` — a rejected application is superseded by a new version, never edited.
  version Int

  /// `ERD.md` §9.6 — the claim AND the checklist version it was made against, frozen together.
  /// Immutable at the GRANT level (D-03): `app_rw` holds no UPDATE on this column.
  snapshot Json

  status      ApplicationStatusEnum @default(SUBMITTED)
  assignedTo  String?               @map("assigned_to") @db.Uuid

  decidedBy     String?                  @map("decided_by") @db.Uuid
  decidedAt     DateTime?                @map("decided_at") @db.Timestamptz(6)
  decision      ApplicationDecisionEnum?
  reasonCodes   String[]                 @default([]) @map("reason_codes")
  reviewerNotes String?                  @map("reviewer_notes")

  precheckResults Json     @default("{}") @map("precheck_results")
  submittedAt     DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents KycDocument[]

  /// The queue index deliberately does NOT lead with tenant_id — it is a platform read under
  /// runElevated (SC-R06). Declared in the migration; Prisma cannot express the exception, so it
  /// is named here rather than silently absent.
  @@unique([tenantId, version], map: "uq_applications__tenant_version")
  @@index([tenantId, submittedAt(sort: Desc)], map: "idx_applications__tenant_submitted_at")
  @@map("applications")
}

/// Retention class `R-KYC` — the row outlives the tenant. There is deliberately NO `deletedAt`:
/// `tombstonedAt` records that the OBJECT was destroyed while the evidence that it existed stays.
model KycDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  documentType KycDocumentTypeEnum @map("document_type")

  /// Globally unique. Object storage has one namespace, so two rows sharing a key would point at
  /// one object and tombstoning either would destroy the other tenant's evidence.
  storageKey  String @unique(map: "uq_kyc_documents__storage_key") @map("storage_key")
  contentHash String @map("content_hash")

  status KycDocumentStatusEnum @default(PENDING)

  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")

  /// NOT a soft delete. A reader filtering this out would hide the evidence.
  tombstonedAt DateTime? @map("tombstoned_at") @db.Timestamptz(6)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)

  /// `ERD.md` §2176 `fk_kyc_documents__kyc_checklists` — which checklist version asked for this
  /// document. Nullable because it is additive over rows that predate M-029.
  kycChecklistId String? @map("kyc_checklist_id") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  application  Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  kycChecklist KycChecklist? @relation(fields: [kycChecklistId], references: [id], onDelete: Restrict)

  @@index([tenantId, documentType, status], map: "idx_kyc_documents__tenant_type_status")
  @@index([applicationId], map: "idx_kyc_documents__application")
  @@index([kycChecklistId], map: "idx_kyc_documents__kyc_checklist_id")
  @@map("kyc_documents")
}

/// `M-029` · The per-country, per-entity-type document checklist — `Schema.md` §12.3, `FR-ONB-03`.
///
/// GLOBAL reference: no `tenantId`, no RLS, and on the committed exemption list. `app_rw` holds
/// SELECT and nothing else, so no Prisma write is reachable from a request even if one were written
/// — the seed runs as the migration role and the `FR-ADMN-06` write path arrives at M-116.
///
/// Versioned as a WHOLE checklist rather than per document, because an application snapshots the
/// version it was judged against (`ERD.md` §9.6) and a version is only meaningful if it names a
/// complete set.
model KycChecklist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  countryCode String         @map("country_code") @db.Char(2)
  entityType  EntityTypeEnum @map("entity_type")
  version     Int

  /// Ordered items. Shape held by the `ck_kyc_checklists__items_*` jsonpath constraints, not by
  /// convention — `Schema.md` §11 lists this column among the thirty-one sanctioned JSONB columns
  /// and closes with "a JSONB column used to avoid designing a schema is a review rejection".
  items Json

  /// NULL is the live version. A superseded version is never deleted: an application that cited it
  /// must stay readable.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)

  kycDocuments KycDocument[]

  @@unique([countryCode, entityType, version], map: "uq_kyc_checklists__country_entity_version")
  @@map("kyc_checklists")
}

enum ApplicationStatusEnum {
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUESTED
  APPROVED
  REJECTED

  @@map("application_status_enum")
}

enum ApplicationDecisionEnum {
  APPROVED
  REJECTED
  INFO_REQUESTED

  @@map("application_decision_enum")
}

enum KycDocumentTypeEnum {
  PAN
  GSTIN
  BUSINESS_REGISTRATION
  SHOP_ESTABLISHMENT
  BANK_PROOF
  OWNER_IDENTITY
  PREMISES_ADDRESS_PROOF
  TRADE_LICENCE
  FIRE_SAFETY_NOC
  MUSIC_LICENCE
  OTHER

  @@map("kyc_document_type_enum")
}

enum KycDocumentStatusEnum {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED

  @@map("kyc_document_status_enum")
}
