{
  "name": "@gymmap/server",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "//": "NOT type:module. NestJS + emitDecoratorMetadata is CommonJS territory; see packages/config/tsconfig/nest.json.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no-op\"",
    "architecture": "echo \"no-op\"",
    "test:unit": "node --test test/*.spec.ts",
    "test:int": "node --test --test-concurrency=1 test/*.int-spec.ts",
    "test:contract": "echo \"no-op\"",
    "test:isolation": "node --test --test-concurrency=1 \"test/isolation/*-spec.ts\"",
    "test:e2e": "echo \"no-op\"",
    "test:a11y": "echo \"no-op\"",
    "size": "echo \"no-op\"",
    "openapi:check": "node ../../packages/config/scripts/api-gates.mjs",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsc -p tsconfig.build.json && node dist/../prisma/seed/index.js",
    "openapi:emit": "tsc -p tsconfig.build.json && node dist/common/openapi/emit.js",
    "db:setup": "prisma migrate deploy && docker exec -i gymmap-postgres psql -U postgres -d gymmap -v ON_ERROR_STOP=1 -f - < ../../infra/compose/set-local-role-password.sql"
  },
  "devDependencies": {
    "@gymmap/config": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@gymmap/types": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^6.19.3",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "//test:isolation": "M-015 · ONE glob covering every *-spec.ts under test/isolation/. The previous form listed *.int-spec.ts and *.isolation-spec.ts explicitly, which silently excluded dropped-policy.negative-spec.ts — A7, the assertion that makes the other six falsifiable. A file that exists and is never run is the exact failure this milestone is about, and it was in the milestone's own script."
}
